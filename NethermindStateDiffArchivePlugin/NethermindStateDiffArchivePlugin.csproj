<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <!-- Types keep their original in-tree namespace so the source files are copied verbatim. -->
        <RootNamespace>Nethermind.StateDiffArchive</RootNamespace>
    </PropertyGroup>

    <ItemGroup>
        <!-- Snappier is shipped by the runner (Nethermind.Network depends on it), so it is resolved from
             the runner base dir at load time and does not need copying next to the plugin DLL. -->
        <PackageReference Include="Snappier" Version="1.3.1" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="../../nethermind/src/Nethermind/Nethermind.Api/Nethermind.Api.csproj" />
        <ProjectReference Include="../../nethermind/src/Nethermind/Nethermind.Blockchain/Nethermind.Blockchain.csproj" />
        <ProjectReference Include="../../nethermind/src/Nethermind/Nethermind.Config/Nethermind.Config.csproj" />
        <ProjectReference Include="../../nethermind/src/Nethermind/Nethermind.Consensus/Nethermind.Consensus.csproj" />
    </ItemGroup>

    <ItemGroup>
      <Folder Include="out\" />
    </ItemGroup>

</Project>
